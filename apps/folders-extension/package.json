{
  "name": "folders-extension",
  "description": "Folders for YouTube subscriptions and playlists",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "STORE=1 wxt zip",
    "zip:unpacked": "wxt zip",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "STORE=1 wxt zip -b firefox --mv3",
    "zip:edge": "STORE=1 wxt zip -b edge",
    "zip:all": "STORE=1 wxt zip && STORE=1 wxt zip -b edge && STORE=1 wxt zip -b firefox --mv3",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@yt/ext-storage": "workspace:*",
    "@yt/shared": "workspace:*",
    "@yt/ui": "workspace:*",
    "@yt/youtube-client": "workspace:*",
    "@yt/youtube-dom": "workspace:*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "@yt/tsconfig": "workspace:*",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  }
}
